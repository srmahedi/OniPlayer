Root: HKLM; Subkey: "Software\Classes\OniPlayer.avi\shell\open\command"; ValueType: string; ValueName: ""; ValueData: "{app}\OniPlayer.exe ""%1"""; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Classes\.avi\OpenWithProgids"; ValueType: none; ValueName: "OniPlayer.avi"
Root: HKLM; Subkey: "Software\OniPlayer\Capabilities\FileAssociations"; ValueType: string; ValueName: ".avi"; ValueData: "OniPlayer.avi"

; WebM
Root: HKLM; Subkey: "Software\Classes\.webm"; ValueType: string; ValueName: ""; ValueData: "OniPlayer.webm"; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Classes\OniPlayer.webm"; ValueType: string; ValueName: ""; ValueData: "OniPlayer Video File"; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Classes\OniPlayer.webm\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\OniPlayer.exe,0"
