Root: HKLM; Subkey: "Software\Classes\.wmv\OpenWithProgids"; ValueType: none; ValueName: "OniPlayer.wmv"
Root: HKLM; Subkey: "Software\OniPlayer\Capabilities\FileAssociations"; ValueType: string; ValueName: ".wmv"; ValueData: "OniPlayer.wmv"

; FLV
Root: HKLM; Subkey: "Software\Classes\.flv"; ValueType: string; ValueName: ""; ValueData: "OniPlayer.flv"; Flags: uninsdeletekey
