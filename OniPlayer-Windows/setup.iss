Root: HKLM; Subkey: "Software\Classes\.webm\OpenWithProgids"; ValueType: none; ValueName: "OniPlayer.webm"
Root: HKLM; Subkey: "Software\OniPlayer\Capabilities\FileAssociations"; ValueType: string; ValueName: ".webm"; ValueData: "OniPlayer.webm"

; Register application in App Paths
Root: HKLM; Subkey: "Software\Microsoft\Windows\CurrentVersion\App Paths\OniPlayer.exe"; ValueType: string; ValueName: ""; ValueData: "{app}\OniPlayer.exe"; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Microsoft\Windows\CurrentVersion\App Paths\OniPlayer.exe"; ValueType: string; ValueName: "Path"; ValueData: "{app}"

; Register application for "Open with" dialog
Root: HKLM; Subkey: "Software\Classes\Applications\OniPlayer.exe\shell\open\command"; ValueType: string; ValueName: ""; ValueData: "{app}\OniPlayer.exe ""%1"""; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Classes\Applications\OniPlayer.exe"; ValueType: string; ValueName: "FriendlyAppName"; ValueData: "OniPlayer"


; Additional video formats
; MOV
Root: HKLM; Subkey: "Software\Classes\.mov"; ValueType: string; ValueName: ""; ValueData: "OniPlayer.mov"; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Classes\OniPlayer.mov"; ValueType: string; ValueName: ""; ValueData: "OniPlayer Video File"; Flags: uninsdeletekey
Root: HKLM; Subkey: "Software\Classes\OniPlayer.mov\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\OniPlayer.exe,0"
