Root: HKLM; Subkey: "Software\Classes\.mov\OpenWithProgids"; ValueType: none; ValueName: "OniPlayer.mov"
Root: HKLM; Subkey: "Software\OniPlayer\Capabilities\FileAssociations"; ValueType: string; ValueName: ".mov"; ValueData: "OniPlayer.mov"

; WMV
Root: HKLM; Subkey: "Software\Classes\.wmv"; ValueType: string; ValueName: ""; ValueData: "OniPlayer.wmv"; Flags: uninsdeletekey
